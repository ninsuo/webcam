{% extends 'base.html.twig' %}

{% block title %}{{ webcam.name }}'s events{% endblock %}

{% block body %}

    <div class="mb-3">
        <a href="{{ path('live', {webcam: webcam.name}) }}">&laquo; back to live</a>
    </div>

    {% if passages is empty %}

        <div class="alert alert-secondary">
            No motion detected yet.
        </div>

    {% endif %}

    {% for passage in passages %}

        <div class="card mb-4">
            <div class="card-header d-flex align-items-center justify-content-between">
                <h5 class="mb-0">
                    {{ passage.start|date('d/m/Y H:i:s') }}
                    {% if passage.end != passage.start %}
                        &rarr; {{ passage.end|date('H:i:s') }}
                    {% endif %}
                </h5>
                <span class="badge bg-primary">{{ passage.count }} image(s)</span>
            </div>
            <div class="card-body text-center">
                <a href="{{ path('event_passage', {webcam: webcam.name, start: passage.start.timestamp}) }}">
                    <img class="img-fluid" loading="lazy"
                         src="{{ path('event_frame', {webcam: webcam.name, size: constant('App\\Enum\\Size::ORIGINAL').value, file: passage.best}) }}"
                    />
                </a>

                <div class="mt-3">
                    <a class="btn btn-outline-secondary btn-sm"
                       href="{{ path('event_passage', {webcam: webcam.name, start: passage.start.timestamp}) }}">
                        View all {{ passage.count }} image(s)
                    </a>
                </div>
            </div>
        </div>

    {% endfor %}

{% endblock %}
